<% include('../../functions') %>
<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">

<head>
  <base href="<%= BrandingService.getRootContext() ? BrandingService.getRootContext() : '/'  %>">
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= BrandingService.getRootContext() %>/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= BrandingService.getRootContext() %>/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="<%= BrandingService.getRootContext() %>/favicon-16x16.png">

  <title>
    <%=typeof title == 'undefined' ? TranslationService.t('default-title') : title%>
  </title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Custom CSS -->
  <% if (req.query && req.query.previewToken) { %>
    <link rel="stylesheet" href="<%= BrandingService.getBrandAndPortalPath(req) %>/preview/<%= req.query.previewToken %>.css">
  <% } else { %>
  <link rel="stylesheet" href="<%= BrandingService.getBrandAndPortalPath(req) %>/styles/theme.css">
  <% } %>

  <!-- Current latest jQuery -->
  <script src="<%= BrandingService.getBrandAndPortalPath(req) %>/js/jquery.min.js"></script>
  <!-- Current latest Bootstrap JS  -->
  <script src="<%= BrandingService.getBrandAndPortalPath(req) %>/js/bootstrap.bundle.min.js"></script>
  <script src="<%= BrandingService.getBrandAndPortalPath(req) %>/js/index.bundle.js"></script>


    <angular-bootstrap rootContext="<%= BrandingService.getRootContext() %>" ></angular-bootstrap>
</head>

<body>
  <header class="unified-header-area shadow-sm">
    <div class="container-xl">
      <div class="d-flex align-items-center justify-content-between py-3">
        
        <!-- Logo Area -->
        <div class="header-logo">
          <% if(locals.branding != null && locals.portal != null) { %>
          <%- superPartial("/layout/logo.ejs", branding, portal, true) %>
          <% } else { %>
            <%- include('layout/logo.ejs') %>
          <%}%>
        </div>

        <!-- Main Navigation -->
        <div class="header-nav px-2 px-xl-4" style="flex: 1 1 auto; overflow: hidden;">
          <% if(locals.branding != null && locals.portal != null) { %>
          <%- superPartial("/layout/menu.ejs", branding, portal, true) %>
          <% } else { %>
            <%- include('layout/menu.ejs') %>
          <%}%>
        </div>

        <!-- Utility Area (Search, User Menu & Language) -->
        <div class="header-utility d-flex align-items-center gap-3 flex-nowrap">
          
          <!-- Search Bar -->
          <% if (typeof menu !== 'undefined' && menu && menu.showSearch && req.isAuthenticated && req.isAuthenticated()) { %>
            <div class="search-area d-none d-lg-block" style="min-width: 200px; max-width: 300px;">
              <form class="m-0 p-0 w-100" method="get" action="<%= BrandingService.getBrandAndPortalPath(req) %>/record/search" name="form">
                <div class="input-group flex-nowrap align-items-stretch">
                  <input name="q" type="text" class="form-control" placeholder="<%= TranslationService.t('record-search-basic-search-placeholder') %>" aria-label="<%= TranslationService.t('record-search-basic-search-placeholder') %>" style="height: auto;">
                  <button class="btn btn-primary px-3 d-flex align-items-center justify-content-center" type="submit" style="z-index: 0;"><i class="fa fa-search"></i></button>
                </div>
              </form>
            </div>
          <% } %>

          <div class="user-menu d-flex align-items-center">
            <ul class="d-flex align-items-center m-0 p-0 text-nowrap" style="list-style: none;">
              <% if (!req.isAuthenticated())  { %>
                <li><a href="<%= BrandingService.getBrandAndPortalPath(req) %>/user/login" class="btn btn-primary fw-semibold"><i class="fa fa-user-circle me-2"></i><%= TranslationService.t('menu-login') %></a></li>
              <% } else { %>
                <li class="nav-item dropdown">
                  <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle border rounded-pill px-2 py-1 bg-white shadow-sm" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="gap: 0.5rem; transition: all 0.2s;">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                      <i class="fa fa-user fs-6"></i>
                    </div>
                    <span class="fw-medium text-dark d-none d-sm-inline pe-1" style="font-size: 0.95rem;"><%= req.user.name %></span>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-3" aria-labelledby="userMenuDropdown" style="min-width: 200px; border-radius: 0.5rem;">
                    <li><h6 class="dropdown-header fw-bold text-dark"><%= req.user.name %></h6></li>
                    <li><hr class="dropdown-divider mb-1"></li>
                    <li>
                      <a class="dropdown-item py-2 fw-medium text-danger" href="<%= BrandingService.getBrandAndPortalPath(req) %>/user/logout">
                        <i class="fa fa-sign-out-alt me-2"></i><%= TranslationService.t('menu-logout') %>
                      </a>
                    </li>
                  </ul>
                </li>
              <% } %>
            </ul>
          </div>

          <div class="dropdown language-selector">
            <%
              const languages = (typeof availableLanguages !== 'undefined' && availableLanguages) ? availableLanguages : [{ code: 'en', displayName: 'English' }];
              if (languages.length > 1) {
                const currentLang = languages.find(l => l.code === lang) || languages[0];
              %>
              <a class="dropdown-toggle text-decoration-none fw-semibold" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                <%= currentLang.displayName %>
              </a>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                <%
                for (const language of languages) {
                  if (language.code !== lang) {
                    const langUrl = new URL(`${req.protocol}://${req.get('host')}${req.originalUrl}`);
                    const params = new URLSearchParams(langUrl.search);
                    params.set('lng', language.code);
                    langUrl.search = params;
                    %>
                    <li><a class="dropdown-item" href="<%= langUrl.toString() %>"><%= language.displayName %></a></li>
                    <%
                  }
                }
              %>
              </ul>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </header>
  <!-- End unified header -->
<% if (typeof title!== 'undefined') { %>
<% } %>

<%
  var brandingName = BrandingService.getBrandNameFromReq(req);
  var portalName = BrandingService.getPortalFromReq(req);
  var systemMessageConfig = sails.config.brandingAware(brandingName).systemMessage || {};
  // We use FNV-1a hash to generate a short, value-based identifier for the system message content.
  // This is used to track changes in the system message content and only re-render the message when it changes as it's light and fast and collisions aren't a huge concern.
  function fnv1aHash(str) {
    var hash = 2166136261;
    for (var i = 0; i < str.length; i++) {
      hash ^= str.charCodeAt(i);
      hash = Math.imul(hash, 16777619);
    }
    return ('0000000' + (hash >>> 0).toString(16)).slice(-8);
  }
  var rawSystemMessageKey = JSON.stringify({
    title: systemMessageConfig.title || '',
    message: systemMessageConfig.message || ''
  });
  var systemMessageKey = fnv1aHash(rawSystemMessageKey);
  var systemMessageScope = brandingName + ':' + portalName;
%>
<% if (systemMessageConfig.enabled === true) { %>
  <div id="system-message-area" class="container-xl"
    data-system-message-key="<%= systemMessageKey %>"
    data-system-message-scope="<%= systemMessageScope %>">
  <div id="system-message" class="alert alert-primary alert-dismissible fade show" role="alert">
    <h4><%- systemMessageConfig.title || '' %></h4>
    <div><%- systemMessageConfig.message || '' %></div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
 <% } %>

  <div class="maincontent-body">
    <%- body %>
  </div>



  <div class="footer-bottom-area navbar-bottom">
    <% if(locals.branding != null && locals.portal != null) { %>
      <%- superPartial("/layout/footer.ejs", branding, portal, true) %>
      <% } else { %>
        <%- include('layout/footer.ejs') %>
      <%}%>

  </div>



</body>
</html>
