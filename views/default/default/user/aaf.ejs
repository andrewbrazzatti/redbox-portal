<div class="row">
    <div class="col-md-offset-5 col-md-3">
      <div class="bento-card mb-4">
        <div class="card-body p-4 text-center">
          <h4 class="fw-semibold mb-3"><%= TranslationService.t('aaf-title') %></h4>
          <% 
            const brandingAwareConfig = typeof sails.config.brandingAware === 'function' ? sails.config.brandingAware(branding) : {};
            const brandAuthConfig = brandingAwareConfig.auth || {};
            const aafConfig = brandAuthConfig.aaf || {};
            const aafLoginUrl = aafConfig.loginUrl || '#';
          %>
          <a href='<%= aafLoginUrl %>'><img src='<%= BrandingService.getRootContext() %>/images/aaf_service_223x54.png' alt="<%= TranslationService.t('aaf-logo-alt-text') %>" class="img-fluid"/></a>
        </div>
      </div>
    </div>
</div>
