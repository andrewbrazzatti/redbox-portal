<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">

<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%=typeof title == 'undefined' ? 'ReDBox' : title%>
  </title>

  <!-- Google Fonts -->
  <link href='https://fonts.googleapis.com/css?family=Titillium+Web:400,200,300,700,600' rel='stylesheet' type='text/css'>
  <link href='https://fonts.googleapis.com/css?family=Roboto+Condensed:400,700,300' rel='stylesheet' type='text/css'>
  <link href='https://fonts.googleapis.com/css?family=Raleway:400,100' rel='stylesheet' type='text/css'>

  <!-- Bootstrap -->
  <link rel="stylesheet" href="<%= BrandingService.getBrandAndPortalPath(req) %>/styles/4_1_3-bootstrap.min.css">

  <!-- Font Awesome included via compiled SCSS (FA6) -->

  <!-- Custom CSS -->
  <link rel="stylesheet" href="<%= sails.config.appUrl %><%= BrandingService.getRootContext() %>/styles/style.css">
  <link rel="stylesheet" href="<%= sails.config.appUrl %><%= BrandingService.getRootContext() %>/styles/responsive.css">
  <% if (req.query && req.query.previewToken) { %>
    <link rel="stylesheet" href="<%= sails.config.appUrl %><%= BrandingService.getRootContext() %>/<%= typeof theme == 'undefined' ? req.param('theme') : theme %>/<%= typeof portal == 'undefined' ? req.param('portal') : portal %>/preview/<%= req.query.previewToken %>.css">
  <% } else { %>
    <link rel="stylesheet" href="<%= sails.config.appUrl %><%= BrandingService.getRootContext() %>/<%= typeof theme == 'undefined' ? req.param('theme') : theme %>/<%= typeof portal == 'undefined' ? req.param('portal') : portal %>/styles/theme.css">
  <% } %>
</head>

<body>

  <header class="unified-header-area shadow-sm">
    <div class="container-xl">
      <div class="d-flex align-items-center justify-content-between py-3">
        <!-- Logo Area -->
        <div class="header-logo">
          <% if(locals.branding != null && locals.portal != null) { %>
            <%- superPartial("/layout/logo.ejs", branding, portal, true) %>
          <% } else { %>
            <%- include('../layout/logo.ejs') %>
          <%}%>
        </div>

        <!-- Main Navigation -->
        <div class="header-nav px-2 px-xl-4" style="flex: 1 1 auto; overflow: hidden;">
          <% if(locals.branding != null && locals.portal != null) { %>
            <%- superPartial("/layout/menu.ejs", branding, portal, true) %>
          <% } else { %>
            <%- include('../layout/menu.ejs') %>
          <%}%>
        </div>

        <!-- Utility Area -->
        <div class="header-utility d-flex align-items-center gap-3 flex-nowrap">
          <div class="user-menu d-flex align-items-center">
            <ul class="d-flex align-items-center m-0 p-0 text-nowrap" style="list-style: none;">
              <% if (!req.isAuthenticated())  { %>
                <li><a href="<%= BrandingService.getBrandAndPortalPath(req) %>/user/login" class="btn btn-primary fw-semibold"><i class="fa fa-user-circle me-2"></i><%= TranslationService.t('menu-login') || 'Login' %></a></li>
              <% } else { %>
                <li class="nav-item dropdown">
                  <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle border rounded-pill px-2 py-1 bg-white shadow-sm" id="userMenuDropdownRecord" data-bs-toggle="dropdown" aria-expanded="false" style="gap: 0.5rem; transition: all 0.2s;">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                      <i class="fa fa-user fs-6"></i>
                    </div>
                    <span class="fw-medium text-dark d-none d-sm-inline pe-1" style="font-size: 0.95rem;"><%= req.user.name %></span>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-3" aria-labelledby="userMenuDropdownRecord" style="min-width: 200px; border-radius: 0.5rem;">
                    <li><h6 class="dropdown-header fw-bold text-dark"><%= req.user.name %></h6></li>
                    <li><hr class="dropdown-divider mb-1"></li>
                    <li>
                      <a class="dropdown-item py-2 fw-medium text-danger" href="<%= BrandingService.getBrandAndPortalPath(req) %>/user/logout">
                        <i class="fa fa-sign-out-alt me-2"></i><%= TranslationService.t('menu-logout') || 'Logout' %>
                      </a>
                    </li>
                  </ul>
                </li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>
  <!-- End mainmenu area -->

  <div class="maincontent-title-area">
    <div class="container-xl">
      <div class="row">
        <div class="col-md-12">
          <div class="maincontent-bit-title text-center">
            <h2>Researcher Dashboard</h2>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="maincontent-body">
    <%- body %>
  </div>



  <div class="footer-bottom-area navbar-bottom">
    <div class="container-xl">
      <div class="row">
        <div class="col-md-8">
          <div class="copyright">
            <p>&copy; <%= new Date().getFullYear() %> Queensland Cyber Infrastructure Foundation</p>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Latest jQuery form server -->
  <script src="<%= BrandingService.getBrandAndPortalPath(req) %>/js/jquery.min.js"></script>

  <!-- Bootstrap JS form CDN -->
  <script src="<%= BrandingService.getBrandAndPortalPath(req) %>/js/3_4_1-bootstrap.min.js"></script>


</body>

</html>
