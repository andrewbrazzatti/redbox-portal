<div class="default-page">
<div class="header mb-4 pt-3">
    <h1 id="main-title" class="container-xl fw-bold text-slate-900 tracking-tight"><%- TranslationService.t('welcome-title') %></h1>
    <p class="container-xl text-slate-500 mt-1 mb-0" style="font-size: 1.05rem;">Manage your research data records and workspaces from one place.</p>
</div>
<div class="container-xl">
  <div class="row g-4 bento-grid">
  <% if (typeof homePanels !== 'undefined' && homePanels && homePanels.panels && homePanels.panels.length > 0) { %>
    <% for (let i = 0; i < homePanels.panels.length; i++) { 
         const panel = homePanels.panels[i]; %>
      <div class="<%= panel.columnClass %> bento-container" style="animation-delay: <%= i * 100 %>ms">
        <div class="bento-card h-100">
           <div class="card-header bg-transparent border-bottom-0 pt-5 pb-0 px-5 text-center">
               <div class="mb-3">
                 <div class="icon-wrapper d-inline-flex align-items-center justify-content-center bg-slate-50 rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="<%= panel.iconClass %> fa-2x text-rose-600"></i>
                 </div>
                 <h2 class="h4 fw-bold text-slate-900 mb-0"><%= panel.title %></h2>
               </div>
           </div>
           <div class="card-body p-5 pt-3">
             <div class="d-grid gap-2">
               <% for (const item of panel.items) { %>
                 <a class="btn btn-outline-slate text-start py-3 px-4 rounded-3 hover-bg-slate-50 transition-all border-slate-100" 
                    <% if (item.external) { %>rel="noopener noreferrer" target="_blank"<% } %> 
                    href="<%= item.href %>">
                    <span class="fw-medium"><%= item.label %></span>
                    <i class="fa fa-chevron-right float-end mt-1 small opacity-30"></i>
                 </a>
               <% } %>
             </div>
           </div>
        </div>
      </div>
    <% } %>
  <% } else { %>
      <!-- Fallback static panels -->
      <div class="col-md-3 bento-container" style="animation-delay: 0ms">
        <div class="bento-card h-100">
           <div class="card-header bg-transparent border-bottom-0 pt-5 pb-0 px-5 text-center">
               <div class="mb-3">
                 <div class="icon-wrapper d-inline-flex align-items-center justify-content-center bg-slate-50 rounded-circle mb-3" style="width: 80px; height: 80px;">
                    <i class="fa fa-check-square fa-2x text-rose-600"></i>
                 </div>
                 <h2 class="h4 fw-bold text-slate-900 mb-0"><%= TranslationService.t('menu-plan')%></h2>
               </div>
           </div>
           <div class="card-body p-5 pt-3">
             <div class="d-grid gap-2">
               <a class="btn btn-outline-slate text-start py-3 px-4 rounded-3 hover-bg-slate-50 transition-all border-slate-100" href="<%= BrandingService.getBrandAndPortalPath(req) %>/record/rdmp/edit">
                  <span class="fw-medium"><%= TranslationService.t('create-rdmp')%></span>
                  <i class="fa fa-chevron-right float-end mt-1 small opacity-30"></i>
               </a>
               <a class="btn btn-outline-slate text-start py-3 px-4 rounded-3 hover-bg-slate-50 transition-all border-slate-100" href="<%= BrandingService.getBrandAndPortalPath(req) %>/dashboard/rdmp">
                  <span class="fw-medium"><%= TranslationService.t('edit-dashboard-rdmp')%></span>
                  <i class="fa fa-chevron-right float-end mt-1 small opacity-30"></i>
               </a>
             </div>
           </div>
        </div>
      </div>
      <!-- Additional fallback panels omitted for brevity, but they should follow this pattern -->
  <% } %>
  </div>
</div>
  </div>
</div>

<!-- simple jquery script to make all the panels equal height -->
<script <% if (typeof contentSecurityPolicyNonce !== "undefined" && contentSecurityPolicyNonce) {%>nonce="<%= contentSecurityPolicyNonce %>"<% } %>>
  $( document ).ready(function() {
   const panels = document.querySelectorAll('.homepanel .panel-default .card-body p-4');
   let maxHeight = 0;
   for (let i = 0; i < panels.length; i++) {
      const panel = panels[i];
      const panelHeight = panel.offsetHeight;
      if (maxHeight < panelHeight) {
        maxHeight = panelHeight;
      }
    }
    for (let panel of panels) {
      panel.style.minHeight = `${maxHeight}px`;
    }
  });
</script>
</div>
