<nav class="navbar navbar-expand-lg w-100 p-0">
  <button type="button" class="navbar-toggle" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
      <span class="sr-only"><%= TranslationService.t('menu-toggle')%></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
  </button>
  <div class="collapse navbar-collapse" id="navbarSupportedContent">
    <ul class="nav navbar-nav d-flex flex-row flex-nowrap gap-2 gap-xl-3 align-items-center" style="overflow-x: auto; white-space: nowrap; scrollbar-width: none;">

      <% 
      var menuConfig = (typeof menu !== 'undefined') ? menu : null;
      if (menuConfig && menuConfig.items && menuConfig.items.length > 0) {
        for (const item of menuConfig.items) {
          if (item.children && item.children.length > 0) { %>
            <li class="nav-item dropdown<%= item.active ? ' active' : '' %>">
              <a class="nav-link dropdown-toggle fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><%= item.label %></a>
              <ul class="dropdown-menu shadow-sm border-0 mt-3" style="border-radius: 0.5rem;">
                <% for (const child of item.children) { %>
                  <li><a class="dropdown-item py-2<%= child.active ? ' active' : '' %>"
                      href="<%= child.href %>"
                      <% if (child.external) { %>target="_blank" rel="noopener noreferrer"<% } %>
                    ><%= child.label %></a></li>
                <% } %>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item<%= item.active ? ' active' : '' %>">
              <a class="nav-link fw-semibold" href="<%= item.href %>"
                 <% if (item.external) { %>target="_blank" rel="noopener noreferrer"<% } %>
              ><%= item.label %></a>
            </li>
          <% }
        }
      } %>

    </ul>
    
  </div>
</nav>
